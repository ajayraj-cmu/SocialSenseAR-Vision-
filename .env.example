# Copy to .env and fill in values. Do not commit .env to git.
# For local runs (optional): server/main.py and some tools read this.
# For Modal: these are usually stored in a Modal Secret (see RUNNING.md).

GEMINI_API_KEY=
OPENAI_API_KEY=

# Hugging Face tokens — separate tokens for PersonaPlex vs SAM3
# HF_SAM_TOKEN: gated access for facebook/sam3 (required for segmentation)
HF_SAM_TOKEN=
# HF_PERSONAPLEX_TOKEN: gated access for nvidia/personaplex-7b-v1 (required only if PersonaPlex enabled)
HF_PERSONAPLEX_TOKEN=
# HF_TOKEN: legacy fallback — used if the specific token above is not set
HF_TOKEN=

# PersonaPlex (optional — set to enable speech-to-speech voice agent)
# PERSONAPLEX_ENABLED=false
# PERSONAPLEX_URL=ws://localhost:8998/api/chat

# Optional: only if you need to SET a new Modal token (e.g. after `modal token new`).
# Leave empty; Modal CLI uses its own stored token after `modal setup`.
# MODAL_TOKEN_SET=
